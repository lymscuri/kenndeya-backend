# Variables d'environnement pour Kendeya Backend
# Copier ce fichier vers .env pour le développement local

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=%o8fjwdf+9jcc35b7q@(2e##ig@ky9x^(o8m7ir=3)5x-giq14

# Base de données PostgreSQL (fourni automatiquement par Railway en production)
DATABASE_URL=postgresql://localhost/kendeya_db

# Redis (fourni automatiquement par Railway en production)
REDIS_URL=redis://localhost:6379/0

# Hosts autorisés (séparer par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (séparer par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMS (Twilio) - Optionnel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Classification firstaid (POST /api/v1/firstaid/classify/ et /answer/) - Groq
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
FIRSTAID_CLASSIFY_MIN=0.6
