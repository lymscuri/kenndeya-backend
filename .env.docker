# Variables d'environnement pour Docker
# Copier ce fichier vers .env et adapter les valeurs

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-IN-PRODUCTION

# Base de données PostgreSQL
DATABASE_URL=postgresql://kendeya_user:kendeya_password@db:5432/kendeya_db

# Redis
REDIS_URL=redis://redis:6379/0

# Hosts autorisés (séparer par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS (séparer par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Superutilisateur (optionnel, pour création automatique)
DJANGO_SUPERUSER_EMAIL=admin@kendeya.com
DJANGO_SUPERUSER_PASSWORD=ChangeMeInProduction
